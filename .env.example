# Anthropic Claude API Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ONNX Model Release Configuration  
ONNX_MODEL_RELEASE_TAG=v1.0.0-onnx-model

# Vercel Environment Variables
# Set these in your Vercel dashboard or via CLI:
# vercel env add ANTHROPIC_API_KEY production
# vercel env add ONNX_MODEL_RELEASE_TAG production
# vercel env add ANTHROPIC_API_KEY preview 
# vercel env add ONNX_MODEL_RELEASE_TAG preview
# vercel env add ANTHROPIC_API_KEY development
# vercel env add ONNX_MODEL_RELEASE_TAG development